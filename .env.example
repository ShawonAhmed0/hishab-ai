# Copy to .env.local and fill in from your Supabase project settings.

# --- Supabase (Project Settings → API) --------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Postgres (Project Settings → Database → Connection string → URI) -------
# The application connects directly so that posting can run in one real
# transaction. Use the session pooler (port 5432) rather than the transaction
# pooler; prepared statements are already disabled in packages/db/src/client.ts.
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
DATABASE_POOL_MAX=10
