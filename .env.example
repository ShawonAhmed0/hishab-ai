# Copy to .env.local and fill in from your Supabase project settings.

# --- Supabase (Project Settings → API) --------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Postgres (Project Settings → Database → Connection string) -------------
#
# Use a POOLER host. The direct host (db.<ref>.supabase.co) is IPv6-only and
# fails with getaddrinfo ENOTFOUND on any machine without IPv6.
#
# Local dev — session pooler, port 5432:
#   postgresql://hishabai_app.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
#
# Vercel or any serverless host — TRANSACTION pooler, port 6543, and one
# connection per lambda. Session mode runs out of client slots almost
# immediately under serverless fan-out.
#
# Both tenant paths are safe in transaction mode: withTenant() sets its
# identity with set_config(..., true), scoped to the transaction, and
# tenantRead() sends context and query as one simple-query batch, which
# Postgres runs as a single implicit transaction. Verified against 6543 — a
# foreign company id still returns zero rows and no context survives the batch.
#
# The port matters for one more reason: prepared statements are worth a round
# trip in two on 5432 and would break on 6543, so client.ts turns them on or
# off by reading the port out of this URL. Get it wrong and you get either
# needless latency or "prepared statement does not exist".
#   postgresql://hishabai_app.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
#
# Run scripts/create-app-role.mjs first — the app must NOT connect as the
# `postgres` role, which has BYPASSRLS and silently disables every policy.
DATABASE_URL=postgresql://hishabai_app.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# 5 locally; set to 1 on Vercel.
DATABASE_POOL_MAX=5

# Owner connection, used by `npm run db:migrate` only. Never set this in Vercel.
SUPABASE_DB_ADMIN_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
