{
  "name": "@hishabai/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -b",
    "generate": "node --env-file-if-exists=../../.env.local ./node_modules/.bin/drizzle-kit generate",
    "migrate": "node --env-file-if-exists=../../.env.local --import tsx src/migrate.ts"
  },
  "dependencies": {
    "@hishabai/shared": "*",
    "drizzle-orm": "^0.38.3",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "drizzle-kit": "^0.30.1",
    "tsx": "^4.19.2"
  }
}
